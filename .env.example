# Copy to .env and fill in for live scoring (never commit .env).
# Velt agents REST API base URL for the environment the run happened in.
VELT_API_BASE=
# Workspace API key and auth token (x-velt-api-key / x-velt-auth-token).
VELT_API_KEY=
VELT_AUTH_TOKEN=
# Optional: path to a Playwright module for scripts/dump-layout.mjs.
PLAYWRIGHT_MODULE=
